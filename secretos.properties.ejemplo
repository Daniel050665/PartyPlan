# =====================================================================
# LLAVES DE WOMPI PARA TU COMPUTADOR
# 1. Copia este archivo y llama a la copia: secretos.properties
#    (en la misma carpeta, junto a pom.xml)
# 2. Pega tus llaves de Wompi en modo Sandbox (deben decir "test").
#    Estan en comercios.wompi.co -> Desarrollo -> Desarrolladores.
# secretos.properties esta en .gitignore: NUNCA se sube a GitHub.
# En tu computador la LLAVE PRIVADA es necesaria: con ella el backend le
# pregunta a Wompi si el pago se aprobo (Wompi no puede volver a localhost).
# =====================================================================
wompi.public-key=pub_test_PEGA_AQUI_TU_LLAVE
wompi.private-key=prv_test_PEGA_AQUI_TU_LLAVE
wompi.integrity-key=test_integrity_PEGA_AQUI_TU_SECRETO
wompi.events-secret=test_events_PEGA_AQUI_TU_SECRETO
